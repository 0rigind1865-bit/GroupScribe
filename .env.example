# ── LINE Messaging API（LINE Developers Console → Messaging API 分頁）──
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Google Gemini ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL_ID=gemini-embedding-001

# ── Supabase（Settings → API；service role key 只能放在伺服器端）──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Dashboard 登入密碼 ──
ADMIN_PASSWORD=
# LIFF 登入 session 的簽章金鑰（隨機長字串，例：openssl rand -hex 32）
SESSION_SECRET=
# 每日摘要 cron 用的 key：POST /api/digest?key=<CRON_SECRET>
CRON_SECRET=

# ── Provider 選擇（規劃書 6.1；目前各只有一個實作）──
LLM_PROVIDER=gemini
VISION_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
CONNECTOR=line

# ── LIFF 成員版 / 管理員 LINE Login（LINE Developers → LINE Login channel）──
# LIFF ID 前段即 Login channel ID；Login channel 必須與 Messaging API 同一個 Provider
LIFF_ID=
# 群記官方帳號的 Basic ID（例如 @057qvdrh），今天頁上手卡的「加好友」按鈕用；留空就不顯示按鈕
LINE_BOT_BASIC_ID=
# Login channel 的 Channel secret（LINE Login code 交換用；與上面 Messaging API 的不同）
LINE_LOGIN_CHANNEL_SECRET=
# 此 LINE 帳號開 LIFF / LINE Login 即取得平台管理權（免密碼）
ADMIN_LINE_USER_ID=
# 公開網址：OAuth redirect_uri（代理不轉發 host 時需要）＋ bot 貼在群裡的「認領連結」（沒設就不附連結）
APP_BASE_URL=

# ── 時區（txt 匯入的時間解讀依伺服器時區）──
TZ=Asia/Taipei

# ── 示範模式（只給本機截圖／展示；正式站不要設）──
# 設為 1 時，示範群組 DEMO-GROUP 的成員版不需 LINE 登入即可瀏覽
DEMO_MODE=
