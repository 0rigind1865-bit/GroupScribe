# ── LINE Messaging API（LINE Developers Console → Messaging API 分頁）──
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Google Gemini ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL_ID=gemini-embedding-001

# ── Supabase（Settings → API；service role key 只能放在伺服器端）──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Dashboard 登入密碼 ──
ADMIN_PASSWORD=

# ── Provider 選擇（規劃書 6.1；目前各只有一個實作）──
LLM_PROVIDER=gemini
VISION_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
CONNECTOR=line

# ── 時區（txt 匯入的時間解讀依伺服器時區）──
TZ=Asia/Taipei

# ── 示範模式（只給本機截圖／展示；正式站不要設）──
# 設為 1 時，示範群組 DEMO-GROUP 的成員版不需 LINE 登入即可瀏覽
DEMO_MODE=
